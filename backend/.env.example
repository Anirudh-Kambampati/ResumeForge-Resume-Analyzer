# ============================================================
# ResumeForge backend configuration
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# --- AI providers (free tiers only) ---
# At least one of GROQ_API_KEY / OPENROUTER_API_KEY is required.
# Models are tried in order: each Groq model, then the OpenRouter model.
# On a rate limit, outage, timeout or invalid output, the next one is used.

# Groq (primary — much faster). Get a free key at https://console.groq.com/keys
# Stays free as long as no billing is added in the Groq console.
GROQ_API_KEY=
# Optional. Comma-separated, fastest first.
GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b

# OpenRouter (last-resort fallback). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Must be a free model (ends in ":free", or "openrouter/free"); paid models are ignored.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Bring your own key (BYOK) ---
# Users can add their own OpenAI / Anthropic / Gemini / Groq / OpenRouter key
# in the app. It is sent per request (X-LLM-* headers) and never stored.
#   Individual features: the keys above are used first; the user's key only
#                        when they are exhausted.
#   Business features:   always the user's key (AI extraction and briefs).

# --- Abuse protection ---
# Per-IP sliding-window rate limits (requests per window).
RATE_LIMIT_ANALYZE=10
RATE_LIMIT_IMPROVE=30
RATE_LIMIT_PARSE=10
RATE_LIMIT_ATS=10
RATE_LIMIT_REQUIREMENTS=10
RATE_LIMIT_SCREEN=240
RATE_LIMIT_BRIEF=20
# Per-resume AI summaries: one short LLM call per screened candidate.
RATE_LIMIT_SUMMARY=60
RATE_LIMIT_KEY_CHECK=10
RATE_LIMIT_WINDOW_SECONDS=60

# Optional shared secret. When set, the frontend must send it in the
# X-Api-Key header (NEXT_PUBLIC_API_SECRET_KEY on the frontend).
# Leave empty for local development — auth is disabled.
API_SECRET_KEY=
